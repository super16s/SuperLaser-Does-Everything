# Copy this file to .env and fill in what you have. Any source left
# unconfigured is skipped gracefully — the app tells you why in the UI.

# X (Twitter) API v2 Bearer token, from a developer app at
# https://developer.x.com. Paid access tier required for search.
TWITTER_BEARER_TOKEN=

# Comma-separated list of Substack RSS feed URLs to pull from and filter
# by topic. Each entry can optionally be tagged with a category so you
# can scope a search to just that category's feeds in the UI, using
# "category=feed-url" (an entry with no "=" has no category and is only
# searched when no category filter is applied), e.g.
# poetry=https://example1.substack.com/feed,philosophy=https://example2.substack.com/feed
SUBSTACK_FEEDS=

# Mastodon instance to query (defaults to https://mastodon.social).
MASTODON_INSTANCE=https://mastodon.social

# Optional: a Mastodon access token (Settings -> Development -> New
# application on your instance). Without it, topics are matched against
# the instance's public hashtag timeline instead of full-text search.
MASTODON_ACCESS_TOKEN=

# Port for the local server.
PORT=3000
