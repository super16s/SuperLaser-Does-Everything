# Password for the login that protects the whole app. REQUIRED for image
# generation: with this unset, /api/image refuses to run. Use something long.
APP_PASSWORD=
# Optional: fixed key for signing sessions (otherwise random per start, which
# logs everyone out on restart).
SESSION_SECRET=

# Optional: base URL of a running Fooocus-API server
# (https://github.com/mrhan1993/Fooocus-API, default port 8888), which
# enables the image-generation panel. Fooocus needs a GPU, so run it on a
# separate machine and point this at it. Leave blank to disable.
FOOOCUS_API_URL=
# FOOOCUS_PERFORMANCE=Speed
# FOOOCUS_ASPECT_RATIO=1152*896

# Port for the local server.
PORT=3000
